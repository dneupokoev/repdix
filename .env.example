# ==========================================
# Основные настройки приложения
# ==========================================
# ADAPTER определяет, через какой интерфейс работает бот.
# Варианты:
#   - cli:       Консольный режим. Бот общается через терминал (идеально для отладки).
#   - telegram:  Режим Telegram-бота. Требует заполнения TELEGRAM_TOKEN (см. ниже).
ADAPTER=telegram

# БД по умолчанию (ключ из config/databases.yaml).
# Если указано, бот при старте автоматически выбирает эту БД.
# Пример: main_db
DEFAULT_DB=main_db

# Модель по умолчанию (ключ из config/models.yaml).
# Если указано, бот использует эту модель для запросов (если не переключено через /model).
# Пример: tool_calling_model
DEFAULT_MODEL=tool_calling_model

# Если вы тестируете и хотите видеть в чате какая модель ответила:
SHOW_MODEL_IN_RESPONSE=

# Таймаут SQL-запроса в секундах (защита от зависаний базы). По умолчанию: 15.
SQL_QUERY_TIMEOUT=

# ==========================================
# Telegram
# ==========================================
# Токен, полученный у @BotFather в Telegram.
# Формат: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_TOKEN=

# Список ID пользователей через запятую, которым разрешен доступ.
# Узнать свой ID можно у бота @userinfobot.
# Пример: 123456789,987654321
ALLOWED_USERS=123456789

# ==========================================
# Базы данных (подстановки для config/databases.yaml)
# ==========================================
# --- main_db (MySQL) ---
# Хост (IP или домен) сервера MySQL. Пример: your-mysql-host.com
DB_MAIN_HOST=
# Имя пользователя. Пример: db_user
DB_MAIN_USER=
# Пароль пользователя. Пример: your_secure_password
DB_MAIN_PASSWORD=
# Имя базы данных на сервере. Пример: main_database
DB_MAIN_NAME=

# --- pg_local (PostgreSQL) ---
# Пароль для локального PostgreSQL (если используется). Пример: your_postgres_password
PG_LOCAL_PASSWORD=

# ==========================================
# Модели LLM (подстановки для config/models.yaml)
# ==========================================
# --- Модель-исполнитель (с инструментами, для фактов) ---
# URL OpenAI-совместимого API (LM Studio, Ollama, OpenRouter и т.д.).
# Пример: http://localhost:1234/v1
LLM_TOOL_URL=
# API-ключ (если сервер не требует авторизации, пишите no-key).
# Пример: no-key или sk-...
LLM_TOOL_TOKEN=
# Точное имя модели, загруженной на сервере.
# Пример: your-model-name
LLM_TOOL_MODEL=

# --- Модель-аналитик (без инструментов, для сложных вопросов) ---
# URL API облачной или локальной модели (например, DeepSeek, OpenAI).
# Пример: https://api.provider.com/v1
LLM_ANALYSIS_URL=
# API-ключ для доступа к аналитической модели.
# Пример: sk-your_api_key_here
LLM_ANALYSIS_TOKEN=
# Точное имя модели. Пример: your-analysis-model
LLM_ANALYSIS_MODEL=

# ==========================================
# Redis (кэш и история диалогов)
# ==========================================
# Хост Redis. Если бот запущен в Docker, используйте имя сервиса (например, redis).
# Пример: localhost или redis
REDIS_HOST=localhost
# Порт Redis. Стандартный: 6379
REDIS_PORT=6379
# Пароль для Redis - автоматчиески установится и будут использоваться в проекте
REDIS_PASSWORD=

# ==========================================
# Ограничения вывода (UX)
# ==========================================
# Максимальное количество строк из SQL-результата, которые бот покажет в чате.
# Если запрос вернет больше строк, бот выведет первые N и напишет "... (показаны первые N из M)".
# Пример: 100
MAX_ROWS_IN_RESPONSE=

# Максимальная длина одного текстового сообщения (в символах).
# Защищает от ошибок Telegram API (лимит 4096 символов). Если ответ длиннее — он будет обрезан.
# Пример: 4000
MAX_MESSAGE_LENGTH=

# Ротация логов (audit.log)
# Максимальный размер одного файла в байтах (по умолчанию 100 MB = 104857600)
LOG_MAX_BYTES=
# Количество архивных файлов (audit.log.1 ... audit.log.N)
LOG_BACKUP_COUNT=
